# Copy to .env (never commit .env). Only testnet key needed for SESSION A.
# Deployment signer. Funded on testnet via https://faucet.botchain.ai.
PRIVATE_KEY=

# RPC overrides (defaults already point at official endpoints).
BOTCHAIN_TESTNET_RPC=https://rpc.bohr.life
BOTCHAIN_MAINNET_RPC=https://rpc.botchain.ai

# Explorer verification keys (optional for testnet practice).
BOTCHAIN_TESTNET_API_KEY=
BOTCHAIN_MAINNET_API_KEY=
# Only override if your explorer uses a nonstandard API path.
# BOHR_SCAN_API_URL=https://scan.bohr.life/api
# BOTCHAIN_SCAN_API_URL=https://scan.botchain.ai/api

# Metadata store. Neon Postgres connection string (pooled). Required for
# POST/GET /api/metadata. Get it from the Neon dashboard after provisioning.
DATABASE_URL=

# --- Public network configuration (NEXT_PUBLIC_*, safe to expose, never secrets) ---
# Which network the website runs on: testnet or mainnet. Empty means testnet.
# Any other value disables every write.
NEXT_PUBLIC_WINK_NETWORK=testnet

# Testnet vault. Optional: the recorded deployment in deployments/botchainTestnet.json
# is used when these are empty. An address override needs its own block.
NEXT_PUBLIC_VAULT_ADDRESS_TESTNET=
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK_TESTNET=

# Mainnet vault. REQUIRED together for mainnet mode. Leave empty until the real
# mainnet deployment exists. If either is missing the app is "not configured"
# and cannot create, claim or reclaim anything. Testnet data is never reused.
NEXT_PUBLIC_VAULT_ADDRESS_MAINNET=
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK_MAINNET=

# --- Mainnet release safety (shell only, set for ONE command, never in Vercel) ---
# WINK_CONFIRM_MAINNET_DEPLOY=deploy-wink-vault-to-botchain-mainnet-677
# WINK_ALLOW_REDEPLOY=1        # only to replace a recorded deployment on purpose
# WINK_PREFLIGHT_STRICT=1      # make missing/underfunded signer a preflight failure
